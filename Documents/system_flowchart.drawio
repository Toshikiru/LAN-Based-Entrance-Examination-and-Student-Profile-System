        <mxCell id="errorProc" parent="1" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#fbe7e7;strokeColor=#c0392b;strokeWidth=2;fontSize=11.5;fontColor=#7a2020;" value="Reject login; display error naming the account&#39;s actual role if mismatched" vertex="1">
          <mxGeometry height="90" width="240" x="700" y="215" as="geometry" />
