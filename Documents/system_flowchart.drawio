        <mxCell id="decValid" parent="1" style="rhombus;whiteSpace=wrap;html=1;fillColor=#fdf3e3;strokeColor=#b8860b;strokeWidth=2;fontSize=11.5;fontColor=#7a5c00;align=center;" value="&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(122, 92, 0), rgb(184, 158, 79));&quot;&gt;Credentials valid AND selected&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;&lt;div style=&quot;&quot;&gt;&lt;font style=&quot;font-size: 11px;&quot;&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(122, 92, 0), rgb(184, 158, 79));&quot;&gt;&amp;nbsp;role&lt;/span&gt;&lt;span style=&quot;background-color: transparent; color: light-dark(rgb(122, 92, 0), rgb(184, 158, 79));&quot;&gt;&amp;nbsp;matches account role?&lt;/span&gt;&lt;/font&gt;&lt;/div&gt;" vertex="1">
